# ==========================================
# Cinespace Master .gitignore
# ==========================================

# 1. Dependency Directories
# Never commit node_modules; your friend or Render will download them fresh.
node_modules/
/jspm_packages/
web_modules/

# 2. Local Environment Variables & Secrets
# CRITICAL: This prevents leaking your MongoDB URI and Supabase keys to GitHub.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*

# 3. Next.js Build Outputs & Production Artifacts
.next/
out/
build/
dist/

# 4. Local Run & TypeScript Development Caches
# Prevents committing file-watcher logs or temporary server builds.
.ts-node/
ts-node-dev/
*.tsbuildinfo
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 5. Operating System Junk Files
# Hides hidden background layout files generated by Windows/macOS.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 6. IDE / Code Editor Environments
# Keeps your personal VS Code or WebStorm settings out of your friend's workspace.
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?